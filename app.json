{
  "expo": {
    "name": "NØVYX",
    "slug": "bde-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bdeapp",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E13"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bde.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "NØVYX utilise la caméra pour prendre des photos d'événements.",
        "NSPhotoLibraryUsageDescription": "NØVYX accède à vos photos pour les partager dans l'application."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E13"
      },
      "package": "com.bde.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4e9087e3-798f-4c46-93d5-cf4ceea9bbd1"
      }
    },
    "owner": "raphi72"
  }
}
